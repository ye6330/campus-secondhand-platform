# Copy to docker/.env before running docker compose.

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# ===== Redis =====
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ===== RabbitMQ =====
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ===== Nacos =====
NACOS_PORT=8848
NACOS_AUTH_TOKEN=replace_with_your_own_token_at_least_32_chars

# ===== Seata =====
SEATA_PORT=8091
SEATA_IP=your_host_ip

# ===== Host ports =====
GATEWAY_PORT=9000
USER_SERVICE_PORT=9101
PRODUCT_SERVICE_PORT=9102
ORDER_SERVICE_PORT=9103
MESSAGE_SERVICE_PORT=9104
ADMIN_SERVICE_PORT=9105

# ===== Aliyun OSS (image storage) =====
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret

NETWORK_NAME=campus-net
